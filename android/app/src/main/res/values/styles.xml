<resources>
    <style name="AppTheme" parent="Theme.AppCompat.Light">
        <!-- Customize your theme here. -->
        <item name="android:textColor">@color/Black</item>
        <item name="colorPrimary">@color/ColorPrimary</item>
        <item name="colorPrimaryDark">@color/ColorPrimaryDark</item>
        <item name="android:textColorHintInverse">@color/ColorBlue</item>
        <item name="actionBarTheme">@style/ThemeOverlay.AppCompat.Dark.ActionBar</item>
        <item name="buttonStyle">@style/FButton</item>
        <item name="android:buttonStyle">@style/FButton</item>
        <item name="colorAccent">@color/materialGrey300</item>
        <!--To change the background of options menu-->
        <item name="android:actionMenuTextColor">@color/Black</item>
        <item name="android:itemBackground">@color/materialGrey300</item>
        <item name="android:textColorSecondary">@color/ColorRedDark</item>
        <item name="android:typeface">monospace</item>

        <item name="android:textColorHint">@color/ColorAqua</item>
        <item name="colorControlNormal">@color/ColorBlue</item>
        <item name="colorControlActivated">@color/ColorAqua</item>
        <!--item name="colorControlHighlight">@color/ColorAqua</item-->
        <item name="colorControlHighlight">@android:color/transparent</item>
    </style>

    <style name="FButton" parent="Theme.AppCompat.Light">
        <item name="colorControlHighlight">@color/ColorBlue</item>
        <item name="android:textColor">@color/ColorAqua</item>
        <item name="android:textSize">20sp</item>
    </style>
</resources>