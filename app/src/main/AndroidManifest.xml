<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="atlow.chemi.mymada">

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false"/>
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false"/>

    <application
        android:name=".Applicatio"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:ignore="GoogleAppIndexingWarning">

        <uses-library
            android:name="org.apache.http.legacy"
            android:required="false" />

        <meta-data
            android:name="com.google.firebase.ml.vision.DEPENDENCIES"
            android:value="barcode" />
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-7600269766434003~4255496174" />

        <activity
            android:name=".HomePage"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:theme="@style/MyMaterialTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".smsRes"
            android:label="@string/title_activity_sms_res"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/MyMaterialTheme.SmsRes" />
        <activity
            android:name=".InfoActivity"
            android:label="@string/title_activity_info"
            android:screenOrientation="portrait"
            android:theme="@style/MyMaterialTheme">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".HomePage" />
        </activity>
        <activity
            android:name=".PrivacyActivity"
            android:label="@string/title_activity_privacy"
            android:screenOrientation="portrait"
            android:theme="@style/MyMaterialTheme">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".InfoActivity" />
        </activity>
        <activity
            android:name=".contactChatActivity"
            android:label="@string/title_activity_contact"
            android:screenOrientation="portrait"
            android:theme="@style/MyMaterialTheme.Base">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".HomePage" />
        </activity>
        <activity
            android:name=".codeRequest"
            android:label="@string/title_activity_code"
            android:screenOrientation="portrait"
            android:theme="@style/MyMaterialTheme">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".HomePage" />
        </activity>
        <activity
            android:name=".codeC"
            android:label="@string/title_activity_code_c"
            android:screenOrientation="portrait" />
        <activity
            android:name=".MokedPage"
            android:label="@string/title_activity_moked_page"
            android:parentActivityName=".HomePage"
            android:screenOrientation="portrait"
            android:theme="@style/MyMaterialTheme">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="atlow.chemi.mymada.HomePage" />
        </activity>
        <activity
            android:name=".lockPage"
            android:label="@string/app_name"
            android:parentActivityName=".HomePage"
            android:screenOrientation="portrait"
            android:theme="@style/MyMaterialTheme" />
        <activity
            android:name=".UtillTools"
            android:label="@string/button_h"
            android:parentActivityName=".HomePage"
            android:theme="@style/MyMaterialTheme">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="atlow.chemi.mymada.HomePage" />
        </activity>
        <activity
            android:name=".SettingsDesigned"
            android:label="@string/title_activity_settings"
            android:theme="@style/MyMaterialTheme" />
        <activity
            android:name=".SettingsDesignedNotifications"
            android:label="@string/pref_header_notifications"
            android:theme="@style/MyMaterialTheme" />
        <activity
            android:name=".SettingsDesignedNotificationsSounds"
            android:label="@string/pref_header_sound_and_vib"
            android:theme="@style/MyMaterialTheme" />
        <activity
            android:name=".SettingsDesignedAdvanced"
            android:label="@string/pref_header_advanced"
            android:theme="@style/MyMaterialTheme" />
        <activity
            android:name=".SettingsDesignedTools"
            android:label="@string/pref_header_tools"
            android:theme="@style/MyMaterialTheme" />
        <activity
            android:name=".SettingsDesignedAmpm"
            android:label="@string/pref_header_ampm"
            android:theme="@style/MyMaterialTheme" />

        <service
            android:name=".SMSMonitorService"
            android:label="@string/smsMoni" />
        <service
            android:name=".FloatingWidgetService"
            android:enabled="true"
            android:exported="false" />
        <service
            android:name=".MetroService"
            android:label="@string/metroMoni" />
        <service
            android:name=".NotificationService"
            android:enabled="@bool/listener"
            android:label="@string/notiMoni"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <service
            android:name=".NotificationServiceOld"
            android:description="@string/address"
            android:enabled="@bool/listenerO"
            android:exported="true"
            android:label="@string/notiMoni"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/service_config" />

            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
        </service>
        <service
            android:name=".MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <service
            android:name=".MyTileService"
            android:enabled="@bool/tile"
            android:icon="@drawable/ic_metronome_tile"
            android:label="@string/button_d"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>

            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>

        <receiver
            android:name=".BootCompleteReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_REPLACED" />

                <data android:scheme="package" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_RESTARTED" />

                <data android:scheme="package" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />

                <data android:scheme="package" />
            </intent-filter>
        </receiver>
        <receiver android:name=".ActionReciver" />
        <receiver
            android:name=".GrobootRec"
            android:enabled="true"
            android:exported="false" />
        <receiver
            android:name=".MetroWidget"
            android:label="@string/button_d">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/metro_widget_info" />
        </receiver>
    </application>

</manifest>