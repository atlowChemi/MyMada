<?xml version="1.0" encoding="utf-8"?>
<preference-headers xmlns:android="http://schemas.android.com/apk/res/android">
    <header
        android:fragment="atlow.chemi.mymada.SettingsFragemnt"
        android:icon="@drawable/ic_notifications"
        android:title="@string/pref_header_notifications"
        android:summary="@string/pref_head_description_notifications"
        android:id="@+id/notifId">
        <extra android:name="type" android:value="noti" />
    </header>
    <header
    android:fragment="atlow.chemi.mymada.SettingsFragemnt"
    android:icon="@drawable/ic_clock"
    android:title="@string/pref_header_ampm"
    android:summary="@string/pref_head_description_ampm"
    android:id="@+id/dayNightId">
    <extra android:name="type" android:value="ampm" />
</header>
    <header
        android:fragment="atlow.chemi.mymada.SettingsFragemnt"
        android:icon="@drawable/ic_pref_send"
        android:title="@string/pref_header_moked"
        android:summary="@string/pref_head_description_moked"
        android:id="@+id/regionId">
        <extra android:name="type" android:value="rego" />
    </header>
    <header
        android:fragment="atlow.chemi.mymada.SettingsFragemnt"
        android:icon="@drawable/ic_advanced"
        android:title="@string/pref_header_advanced"
        android:summary="@string/pref_head_description_advanced"
        android:id="@+id/advaId">
    <extra android:name="type" android:value="adva" />
</header>
    <header
        android:fragment="atlow.chemi.mymada.SettingsFragemnt"
        android:icon="@drawable/ic_translate"
        android:title="@string/pref_header_language"
        android:summary="@string/pref_head_description_lang"
        android:id="@+id/langId">
        <extra android:name="type" android:value="lang" />
        </header>
</preference-headers>