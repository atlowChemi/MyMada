<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <atlow.chemi.mymada.TimePreference
        android:key="nightStart"
        android:title="@string/nightStart"
        android:summary="@string/nightStartDesc"
        android:defaultValue="23"/>

    <atlow.chemi.mymada.TimePreference
        android:key="nightEnd"
        android:title="@string/nightEnd"
        android:summary="@string/nightEndDesc"
        android:defaultValue="7"/>

    <ListPreference
        android:key="sleepDay"
        android:entries="@array/ampm"
        android:entryValues="@array/ampm_entry"
        android:defaultValue="0"
        android:negativeButtonText="@string/ret"
        android:title="@string/notifDay"
        android:summary="%s"
        />
    <ListPreference
        android:key="sleepNight"
        android:entries="@array/ampm"
        android:entryValues="@array/ampm_entry"
        android:defaultValue="0"
        android:negativeButtonText="@string/ret"
        android:title="@string/notifNight"
        android:summary="%s"
        />

</PreferenceScreen>