<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory android:title="@string/button_h">
        <MultiSelectListPreference
            android:key="Tools"
            android:title="@string/pref_title_tools"
            android:dialogTitle="@string/pref_title_tools"
            android:summary="@string/pref_description_tools"
            android:entryValues="@array/toolsVal"
            android:entries="@array/toolsEntrie"
            android:defaultValue="@array/toolsVal"/>
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/pref_header_notifications">
        <CheckBoxPreference
            android:key="not"
            android:title="@string/pref_title_not"
            android:summaryOn="@string/pref_description_not_on"
            android:summaryOff="@string/pref_description_not_off"
            android:defaultValue="true"/>
        <CheckBoxPreference
            android:key="newWin"
            android:title="@string/pref_title_newWin"
            android:summaryOn="@string/pref_description_newWin_on"
            android:summaryOff="@string/pref_description_newWin_off"
            android:defaultValue="true"/>
        <CheckBoxPreference
            android:key="cutAlarm"
            android:title="@string/pref_title_cutA"
            android:summaryOn="@string/pref_description_cutA_on"
            android:summaryOff="@string/pref_description_cutA_off"
            android:defaultValue="false"/>
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/pref_header_more">
        <CheckBoxPreference
            android:key="stat"
            android:title="@string/pref_title_state"
            android:summaryOn="@string/pref_description_state_on"
            android:summaryOff="@string/pref_description_state_off"
            android:defaultValue="false"/>
        <CheckBoxPreference
            android:key="statVib"
            android:title="@string/pref_title_stateVib"
            android:summaryOn="@string/pref_description_stateVib_on"
            android:summaryOff="@string/pref_description_stateVib_off"
            android:defaultValue="false"/>
        <CheckBoxPreference
            android:key="ride"
            android:title="@string/pref_title_ride"
            android:summaryOn="@string/pref_description_ride_on"
            android:summaryOff="@string/pref_description_ride_off"
            android:defaultValue="false"/>
        <CheckBoxPreference
            android:key="loop"
            android:title="@string/pref_title_loop"
            android:summaryOn="@string/pref_description_loop_on"
            android:summaryOff="@string/pref_description_loop_off"
            android:defaultValue="false"/>
        <CheckBoxPreference
            android:key="shabat"
            android:title="@string/pref_title_shabat"
            android:summaryOn="@string/pref_description_shabat_on"
            android:summaryOff="@string/pref_description_shabat_off"
            android:defaultValue="false"/>
        <atlow.chemi.mymada.IntPre
            android:key="shabatTime"
            android:title="@string/pref_title_shabatT"
            android:inputType="number"
            android:numeric="integer"
            android:maxLength="2"
            android:negativeButtonText="@string/ret"
            android:positiveButtonText="@string/ok"
            />
    </PreferenceCategory>
</PreferenceScreen>