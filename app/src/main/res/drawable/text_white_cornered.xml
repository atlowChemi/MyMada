<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="18dp">
        <shape android:shape="rectangle">
            <!--solid android:color="@color/Shadow" /-->
            <gradient android:gradientRadius="120%"
                android:type="radial"
                android:useLevel="true"
                android:startColor="@color/Shadow"
                android:endColor="@color/ShadowEnd" />
            <corners android:radius="40dp"/>
        </shape>
    </item>
    <item android:bottom="10dp" android:left="5dp" android:right="5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/White" />
            <corners android:radius="40dp" />
        </shape>
    </item>
</layer-list>