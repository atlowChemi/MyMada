<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/activity_horizontal_margin">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:scrollbarStyle="outsideOverlay"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/GLZguideline"
        app:layout_constraintHorizontal_bias="0.6"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layoutDirection="ltr"
            android:orientation="vertical">

            <TextView
                android:id="@+id/EyeTxt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/eyeOpening"
                android:textColor="@color/ColorAqua"
                android:textSize="21sp"
                android:textStyle="bold" />

            <android.support.design.widget.TextInputLayout
                android:id="@+id/Eye"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/EyeTxt"
                android:hint="@string/eyeOpening">

                <Spinner
                    android:id="@+id/EyeS"
                    style="@style/Widget.AppCompat.Spinner.Underlined"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_gravity="left"
                    android:layoutDirection="rtl"
                    android:spinnerMode="dropdown" />
            </android.support.design.widget.TextInputLayout>

            <TextView
                android:id="@+id/VerbalTxt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/Eye"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/verbal"
                android:textColor="@color/ColorAqua"
                android:textSize="21sp"
                android:textStyle="bold" />

            <android.support.design.widget.TextInputLayout
                android:id="@+id/Verbal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/VerbalTxt">

                <Spinner
                    android:id="@+id/VerbalS"
                    style="@style/Widget.AppCompat.Spinner.Underlined"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_gravity="left"
                    android:layoutDirection="rtl"
                    android:spinnerMode="dropdown" />
            </android.support.design.widget.TextInputLayout>

            <TextView
                android:id="@+id/MotorTxt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/Verbal"
                android:gravity="center"
                android:text="@string/motor"
                android:textColor="@color/ColorAqua"
                android:textSize="21sp"
                android:textStyle="bold" />

            <android.support.design.widget.TextInputLayout
                android:id="@+id/Motor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/MotorTxt">

                <Spinner
                    android:id="@+id/MotorS"
                    style="@style/Widget.AppCompat.Spinner.Underlined"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_gravity="left"
                    android:layoutDirection="rtl"
                    android:spinnerMode="dropdown" />
            </android.support.design.widget.TextInputLayout>
        </RelativeLayout>
    </ScrollView>
    <android.support.constraint.ConstraintLayout
        android:id="@+id/convinient"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:maxWidth="250dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/GLZguideline"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:id="@+id/GLZGrade"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/btns_new"
            android:gravity="start|top"
            android:padding="14dp"
            android:textSize="19sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <LinearLayout
            android:id="@+id/GLZInfBG"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/btns_new"
            android:drawablePadding="16dp"
            android:gravity="center_horizontal|top"
            android:padding="14dp"
            android:paddingStart="7dp"
            android:paddingEnd="14dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/GLZGrade">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:contentDescription="@string/app_name"
                android:tint="@color/Black"
                app:srcCompat="@drawable/ic_info" />
            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="10dp"
                android:background="@color/Black" />
            <TextView
                android:id="@+id/GLZInf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:scrollbarSize="4dp"
                android:scrollbars="vertical"
                android:textSize="16sp" />
        </LinearLayout>
    </android.support.constraint.ConstraintLayout>

    <android.support.constraint.Guideline
        android:id="@+id/GLZguideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.64" />
</android.support.constraint.ConstraintLayout>