<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/activity_horizontal_margin">

    <ScrollView
        android:id="@+id/scrollView3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:scrollbarStyle="outsideOverlay"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline"
        app:layout_constraintHorizontal_bias="0.6"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ApperenceTxt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/Appe"
                android:textColor="@color/ColorAqua"
                android:textSize="21sp"
                android:textStyle="bold" />

            <android.support.design.widget.TextInputLayout
                android:id="@+id/Apperence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/ApperenceTxt"
                android:hint="@string/Appe">

                <Spinner
                    android:id="@+id/ApperenceS"
                    style="@style/Widget.AppCompat.Spinner.Underlined"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_gravity="start"
                    android:spinnerMode="dropdown" />
            </android.support.design.widget.TextInputLayout>

            <TextView
                android:id="@+id/PulseTxt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/Apperence"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/Puls"
                android:textColor="@color/ColorAqua"
                android:textSize="21sp"
                android:textStyle="bold" />

            <android.support.design.widget.TextInputLayout
                android:id="@+id/Pulse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/PulseTxt">

                <Spinner
                    android:id="@+id/PulseS"
                    style="@style/Widget.AppCompat.Spinner.Underlined"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_gravity="start"
                    android:spinnerMode="dropdown" />
            </android.support.design.widget.TextInputLayout>

            <TextView
                android:id="@+id/GrimaceTxt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/Pulse"
                android:gravity="center"
                android:text="@string/Grim"
                android:textColor="@color/ColorAqua"
                android:textSize="21sp"
                android:textStyle="bold" />

            <android.support.design.widget.TextInputLayout
                android:id="@+id/Grimace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/GrimaceTxt">

                <Spinner
                    android:id="@+id/GrimaceS"
                    style="@style/Widget.AppCompat.Spinner.Underlined"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_gravity="start"
                    android:spinnerMode="dropdown" />
            </android.support.design.widget.TextInputLayout>

            <TextView
                android:id="@+id/ActivityTxt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/Grimace"
                android:gravity="center"
                android:text="@string/Acti"
                android:textColor="@color/ColorAqua"
                android:textSize="21sp"
                android:textStyle="bold" />

            <android.support.design.widget.TextInputLayout
                android:id="@+id/Activity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/ActivityTxt">

                <Spinner
                    android:id="@+id/ActivityS"
                    style="@style/Widget.AppCompat.Spinner.Underlined"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_gravity="start"
                    android:spinnerMode="dropdown" />
            </android.support.design.widget.TextInputLayout>

            <TextView
                android:id="@+id/RespirationsTxt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/Activity"
                android:gravity="center"
                android:text="@string/Resp"
                android:textColor="@color/ColorAqua"
                android:textSize="21sp"
                android:textStyle="bold" />

            <android.support.design.widget.TextInputLayout
                android:id="@+id/Respirations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/RespirationsTxt">

                <Spinner
                    android:id="@+id/RespirationsS"
                    style="@style/Widget.AppCompat.Spinner.Underlined"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_gravity="start"
                    android:spinnerMode="dropdown" />
            </android.support.design.widget.TextInputLayout>
        </RelativeLayout>
    </ScrollView>

    <android.support.constraint.ConstraintLayout
        android:id="@+id/convinie"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:maxWidth="250dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/guideline"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/ApgarGrade"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/btns_new"
            android:gravity="start|top"
            android:padding="14dp"
            android:textSize="19sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/ApgarInfBG"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/btns_new"
            android:drawablePadding="16dp"
            android:gravity="center_horizontal|top"
            android:padding="14dp"
            android:paddingStart="7dp"
            android:paddingEnd="14dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ApgarGrade">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:contentDescription="@string/app_name"
                android:tint="@color/Black"
                app:srcCompat="@drawable/ic_info" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="10dp"
                android:background="@color/Black" />

            <TextView
                android:id="@+id/ApgarInfi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:scrollbarSize="4dp"
                android:scrollbars="vertical"
                android:textSize="16sp" />
        </LinearLayout>
    </android.support.constraint.ConstraintLayout>

    <android.support.constraint.Guideline
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.64" />

</android.support.constraint.ConstraintLayout>