<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/MyMaterialTheme.SmsRes"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    tools:context=".smsRes"
    android:id="@+id/home">
    <!--android:background="@drawable/rbg"-->
    <!--android:src="@mipmap/background"-->
    <View android:id="@+id/strut"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_centerHorizontal="true"/>
    <Button
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginBottom="16dp"
        android:layout_alignRight="@id/strut"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="3dp"
        android:layout_alignParentLeft="true"
        android:text="@string/Minf"
        android:id="@+id/buttonI"
        android:textSize="20sp"
        android:textColor="@color/White"
        android:gravity="center"
        android:background="@drawable/btns_new"
        android:layout_alignParentBottom="true"/>
    <Button
        android:layout_width="0dp"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="16dp"
        android:layout_height="50dp"
        android:layout_marginBottom="16dp"
        android:text="@string/Mrec2"
        android:layout_alignLeft="@id/strut"
        android:layout_alignParentRight="true"
        android:background="@drawable/btns_new"
        android:textSize="20sp"
        android:textColor="@color/White"
        android:gravity="center"
        android:id="@+id/button"
        android:layout_alignParentBottom="true" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="30sp"
        android:textColor="@color/White"
        android:text="@string/newCall"
        android:id="@+id/newC"
        android:paddingTop="15dp"
        android:paddingBottom="15dp"
        android:background="@color/OldPrimary"
        android:layout_alignParentTop="true"
        android:gravity="center|top"
        android:textStyle="bold" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="19sp"
        android:textColor="@color/ColorAqua"
        android:text=""
        android:id="@+id/msgType"
        android:layout_marginTop="15dp"
        android:paddingTop="15dp"
        android:paddingBottom="15dp"
        android:layout_below="@+id/newC"
        android:gravity="center|top"
        android:textStyle="bold" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="35sp"
        android:textColor="@color/Black"
        android:text=""
        android:id="@+id/Address"
        android:paddingTop="15dp"
        android:paddingBottom="15dp"
        android:maxLines="3"
        android:ellipsize="end"
        android:scrollbarSize="4dp"
        android:scrollbarTrackVertical="@color/ColorPrimary"
        android:scrollbars="vertical"
        android:layout_below="@+id/msgType"
        android:gravity="center|top"
        android:textStyle="bold" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="27sp"
        android:id="@+id/KodR"
        android:layout_marginTop="20dp"
        android:gravity="center|top"
        android:layout_below="@+id/Address"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="22sp"
        android:layout_marginBottom="35dp"
        android:text=""
        android:id="@+id/SMS"
        android:gravity="center|top"
        android:layout_above="@+id/bg" />



    <ImageView
        android:layout_width="match_parent"
        android:contentDescription="@string/hello_world"
        android:layout_height="60dp"
        android:id="@+id/bg"
        android:src="@drawable/ic_mda"
        android:layout_above="@+id/name"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true"
        android:layout_marginBottom="20dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:layout_marginTop="20dp"
        android:id="@+id/name"
        android:text="@string/app_name"
        android:layout_marginBottom="20dp"
        android:textColor="@color/materialGrey600"
        android:gravity="center|top"
        android:layout_above="@+id/buttonI" />

</RelativeLayout>
