<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/homeCon"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:theme="@style/MyMaterialTheme.SmsRes"
    tools:context=".smsRes">

    <TextView
        android:id="@+id/newC"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@color/OldPrimary"
        android:gravity="center|top"
        android:paddingTop="15dp"
        android:paddingBottom="15dp"
        android:text="@string/newCall"
        android:textColor="@color/White"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="19sp"
        android:textColor="@color/ColorAqua"
        android:text=""
        android:id="@+id/msgType"
        android:layout_marginTop="15dp"
        android:paddingTop="15dp"
        android:paddingBottom="15dp"
        android:layout_below="@+id/newC"
        app:layout_constraintTop_toBottomOf="@id/newC"
        android:gravity="center|top"
        android:textStyle="bold" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="35sp"
        android:textColor="@color/Black"
        android:text=""
        android:id="@+id/Address"
        android:paddingTop="15dp"
        android:paddingBottom="15dp"
        android:maxLines="3"
        android:ellipsize="end"
        android:scrollbarSize="4dp"
        android:scrollbarTrackVertical="@color/ColorPrimary"
        android:scrollbars="vertical"
        app:layout_constraintTop_toBottomOf="@id/msgType"
        android:gravity="center|top"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/KodR"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp"
        android:gravity="center|top"
        android:text=""
        android:textSize="27sp"
        app:layout_constraintBottom_toTopOf="@+id/SMS"
        app:layout_constraintTop_toBottomOf="@id/Address" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="22sp"
        android:layout_marginBottom="35dp"
        android:text=""
        android:id="@+id/SMS"
        android:gravity="center|top"
        app:layout_constraintBottom_toTopOf="@+id/bg" />
    <ImageView
        android:layout_width="match_parent"
        android:contentDescription="@string/hello_world"
        android:layout_height="60dp"
        android:id="@+id/bg"
        app:srcCompat="@drawable/ic_mda"
        app:layout_constraintBottom_toTopOf="@+id/name"
        android:layout_marginBottom="20dp" />
    <TextView
        android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:gravity="center|top"
        android:text="@string/app_name"
        android:textColor="@color/materialGrey600"
        android:textSize="18sp"
        app:layout_constraintBottom_toTopOf="@+id/buttonI" />

    <Button
        android:id="@+id/buttonI"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/btns_new"
        android:gravity="center"
        android:text="@string/Minf"
        android:textColor="@color/White"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/button" />
    <Button
        android:id="@+id/button"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/btns_new"
        android:gravity="center"
        android:text="@string/Mrec2"
        android:textColor="@color/White"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/buttonI" />
</androidx.constraintlayout.widget.ConstraintLayout>
