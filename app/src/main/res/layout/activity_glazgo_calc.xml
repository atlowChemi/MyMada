<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/activity_horizontal_margin">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="vertical" android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/eyeOpening"
            android:id="@+id/EyeTxt"
            android:textColor="@color/ColorAqua"
            android:textStyle="bold"
            android:gravity="center"
            android:textSize="21sp"/>
        <android.support.design.widget.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/Eye"
            android:hint="@string/eyeOpening"
            android:layout_below="@+id/EyeTxt">
            <Spinner
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:id="@+id/EyeS"
                style="@style/Widget.AppCompat.Spinner.Underlined"
                android:layout_gravity="start"
                android:spinnerMode="dropdown" />
        </android.support.design.widget.TextInputLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/verbal"
            android:id="@+id/VerbalTxt"
            android:textSize="21sp"
            android:textColor="@color/ColorAqua"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:layout_below="@id/Eye"/>
        <android.support.design.widget.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/Verbal"
            android:layout_below="@+id/VerbalTxt">
            <Spinner
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:id="@+id/VerbalS"
                style="@style/Widget.AppCompat.Spinner.Underlined"
                android:layout_gravity="start"
                android:spinnerMode="dropdown" />
        </android.support.design.widget.TextInputLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/motor"
            android:id="@+id/MotorTxt"
            android:layout_below="@id/Verbal"
            android:textColor="@color/ColorAqua"
            android:textStyle="bold"
            android:gravity="center"
            android:textSize="21sp"/>
        <android.support.design.widget.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/Motor"
            android:layout_below="@+id/MotorTxt">
            <Spinner
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:id="@+id/MotorS"
                style="@style/Widget.AppCompat.Spinner.Underlined"
                android:layout_gravity="start"
                android:spinnerMode="dropdown" />
        </android.support.design.widget.TextInputLayout>
        <TextView
            android:layout_width="match_parent"
            android:scrollbars="vertical"
            android:layout_height="150sp"
            android:textSize="19sp"
            android:id="@+id/GlazgowResultTxt"
            android:layout_below="@+id/Motor"/>
    </RelativeLayout>
    </ScrollView>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/GLZGrade"
        android:background="@drawable/btns_new"
        android:padding="14dp"
        android:textSize="19sp"
        android:layout_marginBottom="8dp"
        android:gravity="start|top"
        android:layout_above="@+id/GLZInfBG"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/GLZInfBG"
        android:background="@drawable/btns_new"
        android:drawablePadding="16dp"
        android:paddingStart="7dp"
        android:padding="14dp"
        android:gravity="center_horizontal|top"
        android:layout_alignParentBottom="true">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:contentDescription="@string/app_name"
            android:tint="@color/Black"
            app:srcCompat="@drawable/ic_info"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/Black"
            android:layout_marginEnd="10dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/GLZInf"
            android:textSize="16sp"/>
    </LinearLayout>
</RelativeLayout>