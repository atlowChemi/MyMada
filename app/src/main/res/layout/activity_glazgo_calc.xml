<?xml version="1.0" encoding="utf-8"?>
<android.support.design.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/activity_horizontal_margin">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="vertical" android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layoutDirection="ltr">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/eyeOpening"
            android:id="@+id/EyeTxt"
            android:textColor="@color/ColorAqua"
            android:textStyle="bold"
            android:gravity="center"
            android:textSize="21sp"/>
        <android.support.design.widget.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/Eye"
            android:hint="@string/eyeOpening"
            android:layout_below="@+id/EyeTxt">
            <Spinner
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layoutDirection="rtl"
                android:id="@+id/EyeS"
                style="@style/Widget.AppCompat.Spinner.Underlined"
                android:layout_gravity="left"
                android:spinnerMode="dropdown" />
        </android.support.design.widget.TextInputLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/verbal"
            android:id="@+id/VerbalTxt"
            android:textSize="21sp"
            android:textColor="@color/ColorAqua"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:layout_below="@id/Eye"/>
        <android.support.design.widget.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/Verbal"
            android:layout_below="@+id/VerbalTxt">
            <Spinner
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:id="@+id/VerbalS"
                android:layoutDirection="rtl"
                style="@style/Widget.AppCompat.Spinner.Underlined"
                android:layout_gravity="left"
                android:spinnerMode="dropdown" />
        </android.support.design.widget.TextInputLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/motor"
            android:id="@+id/MotorTxt"
            android:layout_below="@id/Verbal"
            android:textColor="@color/ColorAqua"
            android:textStyle="bold"
            android:gravity="center"
            android:textSize="21sp"/>
        <android.support.design.widget.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/Motor"
            android:layout_below="@+id/MotorTxt">
            <Spinner
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:id="@+id/MotorS"
                android:layoutDirection="rtl"
                style="@style/Widget.AppCompat.Spinner.Underlined"
                android:layout_gravity="left"
                android:spinnerMode="dropdown" />
        </android.support.design.widget.TextInputLayout>
        <TextView
            android:layout_width="match_parent"
            android:scrollbars="vertical"
            android:layout_height="150sp"
            android:textSize="19sp"
            android:id="@+id/GlazgowResultTxt"
            android:layout_below="@+id/Motor"/>
    </RelativeLayout>
    </ScrollView>
    <android.support.design.widget.FloatingActionButton
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/sendVitalsGlaz"
        android:src="@drawable/ic_done"
        app:backgroundTint="@color/ColorAqua"
        app:rippleColor="@color/ColorBlue"
        android:layout_gravity="bottom|left"
        android:layout_marginLeft="5dp"
        android:layout_marginBottom="5dp"/>
</android.support.design.widget.CoordinatorLayout>