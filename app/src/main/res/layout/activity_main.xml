<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:id="@+id/main3">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingLeft="@dimen/activity_horizontal_margin"
        android:paddingRight="@dimen/activity_horizontal_margin"
        android:paddingTop="@dimen/activity_vertical_margin"
        android:paddingBottom="@dimen/activity_vertical_margin"
        android:layout_marginBottom="10dp"
        android:layoutDirection="ltr"
        android:layout_above="@id/tofes_card_view"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:id="@+id/rap">
            <android.support.v4.widget.NestedScrollView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/scM">
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <android.support.design.widget.TextInputLayout
        android:id="@+id/M1ambulanceNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
            <android.support.design.widget.FixedTextInputEditText
                android:id="@+id/M1txt1E"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:gravity="start"
                android:maxLength="4"
                android:inputType="numberDecimal"
                android:hint="@string/ambN" />
    </android.support.design.widget.TextInputLayout>
        <android.support.design.widget.TextInputLayout
            android:id="@+id/M1visaNumber"
            android:layout_below="@+id/M1ambulanceNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <android.support.design.widget.FixedTextInputEditText
                android:id="@+id/M1visaT"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:gravity="start"
                android:maxLength="4"
                android:inputType="numberDecimal"
                android:hint="@string/visa" />
        </android.support.design.widget.TextInputLayout>
        <android.support.design.widget.TextInputLayout
            android:id="@+id/M1address"
            android:layout_below="@+id/M1visaNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <android.support.design.widget.FixedTextInputEditText
                android:id="@+id/M1addressT"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:gravity="start"
                android:inputType="text"
                android:hint="@string/address" />
        </android.support.design.widget.TextInputLayout>
        <android.support.design.widget.TextInputLayout
            android:id="@+id/M1HoleNifga"
            android:layout_below="@+id/M1address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <android.support.design.widget.FixedTextInputEditText
                android:id="@+id/M1txt2E"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:gravity="start"
                android:inputType="number"
                android:hint="@string/HN" />
        </android.support.design.widget.TextInputLayout>
        <android.support.design.widget.TextInputLayout
        android:id="@+id/M1Hitchayvut"
            android:layout_below="@+id/M1HoleNifga"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <android.support.design.widget.FixedTextInputEditText
            android:id="@+id/M1txt3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:gravity="start"
            android:inputType="numberDecimal"
            android:hint="@string/HT" />
    </android.support.design.widget.TextInputLayout>
        <android.support.design.widget.TextInputLayout
            android:id="@+id/M1Schum"
            android:layout_below="@+id/M1Hitchayvut"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <android.support.design.widget.FixedTextInputEditText
                android:id="@+id/M1txt6E"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:gravity="start"
                android:maxLength="4"
                android:inputType="number"
                android:hint="@string/SUM" />
        </android.support.design.widget.TextInputLayout>
        <android.support.design.widget.TextInputLayout
            android:id="@+id/M1firstName"
            android:layout_below="@+id/M1Schum"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <android.support.design.widget.FixedTextInputEditText
                android:id="@+id/M1txt4E"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:gravity="start"
                android:inputType="text"
                android:hint="@string/Fna" />
        </android.support.design.widget.TextInputLayout>
        <android.support.design.widget.TextInputLayout
            android:id="@+id/M1familyName"
            android:layout_below="@+id/M1firstName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <android.support.design.widget.FixedTextInputEditText
                android:id="@+id/M1txt5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:gravity="start"
                android:imeOptions="actionNext"
                android:inputType="text"
                android:hint="@string/Lna" />
        </android.support.design.widget.TextInputLayout>

        <android.support.design.widget.TextInputLayout
            android:id="@+id/M1MedicalCode"
            android:layout_below="@+id/M1familyName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <android.support.design.widget.FixedTextInputEditText
                android:id="@+id/M1button2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:gravity="start"
                android:focusable="false"
                android:inputType="number"
                android:imeOptions="actionNext"
                android:hint="@string/pickC" />
        </android.support.design.widget.TextInputLayout>
    </RelativeLayout>
    </android.support.v4.widget.NestedScrollView>
    </RelativeLayout>
    <android.support.v7.widget.CardView
        android:id="@+id/tofes_card_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:cardBackgroundColor="@color/ColorNice"
        app:cardCornerRadius="15dp"
        app:cardUseCompatPadding="true"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="@dimen/activity_vertical_margin"
        android:layout_marginEnd="@dimen/activity_vertical_margin"
        app:cardElevation="4dp">
    <Button
        android:id="@+id/M1btnN"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:paddingEnd="@dimen/activity_horizontal_margin"
        android:paddingStart="@dimen/activity_horizontal_margin"
        android:layout_marginBottom="8dp"
        android:background="@drawable/btns_new"
        android:gravity="center|center_horizontal|center_vertical"
        android:text="@string/succ"
        android:textColor="#FFF"
        android:textSize="20sp" />
    </android.support.v7.widget.CardView>
</RelativeLayout>