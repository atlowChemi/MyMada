<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true">
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/OxyTime">
        <TextView
            android:id="@+id/txtOxyMin"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="15"
            android:paddingTop="15dp"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:background="@color/buttonMaterialDark"
            android:textSize="50sp"
            android:textColor="#fff" />

        <TextView
            android:id="@+id/txt_TimerSecond"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/txtOxyMin"
            android:gravity="center_horizontal"
            android:text="@string/oxyLeft"
            android:background="@color/buttonMaterialDark"
            android:textSize="25sp"
            android:textColor="#fff" />
        <TextView
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/txt_TimerSecond"
            android:gravity="center_horizontal"
            android:text="@string/lpmExp"
            android:background="@color/buttonMaterialDark"
            android:textSize="15sp"
            android:textColor="#d6d6d6"
            android:id="@+id/twoOxy"/>
    </RelativeLayout>
    <android.support.design.widget.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/OxyTime"
        android:id="@+id/ballonType"
        android:layout_marginTop="10dp">
        <Spinner
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:id="@+id/OxyTypeS"
            style="@style/Widget.AppCompat.Spinner.Underlined"
            android:layout_gravity="left"
            android:spinnerMode="dropdown" />
    </android.support.design.widget.TextInputLayout>
    <android.support.design.widget.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/ballonType"
        android:clickable="true"
        android:focusable="true"
        android:id="@+id/ATM_TIL">
        <android.support.v7.widget.AppCompatEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:id="@+id/ATM"
            android:maxLength="3"
            android:hint="@string/atm"/>
    </android.support.design.widget.TextInputLayout>
    <android.support.design.widget.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_below="@+id/ATM_TIL"
        android:id="@+id/PSI_TIL">
        <android.support.v7.widget.AppCompatEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/PSI"
            android:inputType="number"
            android:maxLength="4"
            android:hint="@string/psi"/>
    </android.support.design.widget.TextInputLayout>
</RelativeLayout>