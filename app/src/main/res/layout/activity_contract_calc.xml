<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/contractBtn"
        android:clipToPadding="false"
        android:scrollbars="vertical" />
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/buttonMaterialDark"
        android:layout_alignParentBottom="true"
        android:id="@+id/contractBtn">
        <atlow.chemi.mymada.classes.CircularProgressButton
            android:layout_centerHorizontal="true"
            android:id="@+id/contra_btn"
            android:text="@string/startContract"
            android:layout_marginTop="10dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="10dp"
            android:textColor="@color/Ocean"
            android:textSize="30sp"
            android:gravity="center"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:background="@drawable/round_button"
            app:spinning_bar_width="4dp"
            app:finalCornerAngle="100dp"
            app:initialCornerAngle="100dp"
            app:spinning_bar_color="@color/Ocean"
            app:spinning_bar_padding="0dp"/>
    </RelativeLayout>
</RelativeLayout>