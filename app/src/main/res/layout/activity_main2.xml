<android.support.design.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:android.support.design="http://schemas.android.com/tools"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:layoutDirection="ltr"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="55dp">
    <android.support.design.widget.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/M2ambulance">

        <android.support.design.widget.TextInputEditText
            android:id="@+id/M2txt1E"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:gravity="start"
            android:maxLength="4"
            android:inputType="numberDecimal"
            android:hint="@string/ambN" />
    </android.support.design.widget.TextInputLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/explain"
            android:textSize="16sp"
            android:layout_below="@+id/M2ambulance"
            android:textColor="@color/DarkGrey"
            android:text="@string/explain"/>
        <android.support.v7.widget.RecyclerView
            android:id="@+id/recycler_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/explain"
            android:clipToPadding="false"
            android:scrollbars="vertical" />
    </RelativeLayout>
    <android.support.design.widget.FloatingActionButton
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/newMan"
        android:src="@drawable/ic_add"
        app:backgroundTint="@color/ColorAqua"
        android:layout_gravity="bottom|right"
        android:elevation="0dp"
        app:rippleColor="@color/ColorBlue"
        android:layout_marginRight="5dp"
        android:layout_marginBottom="5dp"/>
    <android.support.design.widget.FloatingActionButton
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/M2btn1E"
        android:src="@drawable/ic_send"
        app:backgroundTint="@color/ColorAqua"
        app:rippleColor="@color/ColorBlue"
        android:layout_gravity="bottom|left"
        android:layout_marginLeft="5dp"
        android:layout_marginBottom="5dp"/>
</android.support.design.widget.CoordinatorLayout>