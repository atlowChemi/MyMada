<?xml version="1.0" encoding="utf-8"?>
<android.support.design.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/activity_horizontal_margin">

    <RelativeLayout
        android:orientation="vertical" android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layoutDirection="ltr">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/Appe"
            android:id="@+id/ApperenceTxt"
            android:textColor="@color/ColorAqua"
            android:textStyle="bold"
            android:gravity="center"
            android:textSize="21sp"/>
        <android.support.design.widget.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/Apperence"
            android:hint="@string/Appe"
            android:layout_below="@+id/ApperenceTxt">
            <Spinner
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layoutDirection="rtl"
                android:id="@+id/ApperenceS"
                style="@style/Widget.AppCompat.Spinner.Underlined"
                android:layout_gravity="left"
                android:spinnerMode="dropdown" />
        </android.support.design.widget.TextInputLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/Puls"
            android:id="@+id/PulseTxt"
            android:textSize="21sp"
            android:textColor="@color/ColorAqua"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:layout_below="@id/Apperence"/>
        <android.support.design.widget.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/Pulse"
            android:layout_below="@+id/PulseTxt">
            <Spinner
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:id="@+id/PulseS"
                android:layoutDirection="rtl"
                style="@style/Widget.AppCompat.Spinner.Underlined"
                android:layout_gravity="left"
                android:spinnerMode="dropdown" />
        </android.support.design.widget.TextInputLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/Grim"
            android:id="@+id/GrimaceTxt"
            android:layout_below="@id/Pulse"
            android:textColor="@color/ColorAqua"
            android:textStyle="bold"
            android:gravity="center"
            android:textSize="21sp"/>
        <android.support.design.widget.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/Grimace"
            android:layout_below="@+id/GrimaceTxt">
            <Spinner
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:id="@+id/GrimaceS"
                android:layoutDirection="rtl"
                style="@style/Widget.AppCompat.Spinner.Underlined"
                android:layout_gravity="left"
                android:spinnerMode="dropdown" />
        </android.support.design.widget.TextInputLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/Acti"
            android:id="@+id/ActivityTxt"
            android:textSize="21sp"
            android:textColor="@color/ColorAqua"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_below="@id/Grimace"/>
        <android.support.design.widget.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/Activity"
            android:layout_below="@+id/ActivityTxt">
            <Spinner
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:id="@+id/ActivityS"
                android:layoutDirection="rtl"
                style="@style/Widget.AppCompat.Spinner.Underlined"
                android:layout_gravity="left"
                android:spinnerMode="dropdown" />
        </android.support.design.widget.TextInputLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/Resp"
            android:id="@+id/RespirationsTxt"
            android:layout_below="@id/Activity"
            android:textColor="@color/ColorAqua"
            android:textStyle="bold"
            android:gravity="center"
            android:textSize="21sp"/>
        <android.support.design.widget.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/Respirations"
            android:layout_below="@+id/RespirationsTxt">
            <Spinner
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:id="@+id/RespirationsS"
                style="@style/Widget.AppCompat.Spinner.Underlined"
                android:layout_gravity="left"
                android:layoutDirection="rtl"
                android:spinnerMode="dropdown" />
        </android.support.design.widget.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:scrollbars="vertical"
            android:layout_height="50sp"
            android:textSize="19sp"
            android:id="@+id/ResultTxt"
            android:layout_below="@+id/Respirations"/>
    </RelativeLayout>
    <android.support.design.widget.FloatingActionButton
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/sendVitals"
        android:src="@drawable/ic_done"
        app:backgroundTint="@color/ColorAqua"
        app:rippleColor="@color/ColorBlue"
        android:layout_gravity="bottom|left"
        android:layout_marginLeft="5dp"
        android:layout_marginBottom="5dp"/>
</android.support.design.widget.CoordinatorLayout>