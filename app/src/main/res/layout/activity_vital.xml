<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr"
    android:padding="@dimen/activity_horizontal_margin">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/VitalInfBG"
        android:layout_marginBottom="8dp">
    <LinearLayout android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <RadioGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layoutDirection="rtl"
            android:checkedButton="@+id/old"
            android:id="@+id/radioAge">
            <RadioButton
                android:layout_height="wrap_content"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/radio_old"
                android:id="@+id/old"/>
            <RadioButton
                android:layout_height="wrap_content"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/radio_kid"
                android:id="@+id/kid"/>
            <RadioButton
                android:layout_height="wrap_content"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/radio_baby"
                android:id="@+id/baby"/>
        </RadioGroup>
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/pulsaTIL">
            <android.support.design.widget.FixedTextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/fullPulse"
                android:id="@+id/pulsa"
                android:maxLength="3"
                android:inputType="number"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/breathingTIL">
            <android.support.design.widget.FixedTextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/breathing"
                android:maxLength="3"
                android:id="@+id/breathing"
                android:nextFocusRight="@+id/systolic"
                android:nextFocusDown="@+id/systolic"
                android:inputType="number"/>
        </com.google.android.material.textfield.TextInputLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.95"
                android:id="@+id/systolicTIL">
                <android.support.design.widget.FixedTextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/systolic"
                    android:nextFocusRight="@+id/diastolic"
                    android:nextFocusDown="@+id/diastolic"
                    android:maxLength="3"
                    android:inputType="number"
                    android:id="@+id/systolic"/>
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.1"
                android:text="/"
                android:textSize="40sp"/>
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.95"
                android:id="@+id/diastolicTIL">

                <android.support.design.widget.FixedTextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/diastolic"
                    android:maxLength="3"
                    android:inputType="number"
                    android:imeOptions="actionDone"
                    android:id="@+id/diastolic" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/vitalsResult"
            android:textSize="19sp"/>
    </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/VitalInfBG"
        android:background="@drawable/btns_new"
        android:drawablePadding="16dp"
        android:paddingStart="7dp"
        android:padding="14dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_horizontal|top"
        android:layout_above="@+id/VitalMsgBG">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:tint="@color/Black"
            app:srcCompat="@drawable/ic_info"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/Black"
            android:layout_marginEnd="10dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/VitalInf"
            android:textSize="16sp"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/VitalMsgBG"
        android:background="@drawable/btns_new"
        android:drawablePadding="16dp"
        android:paddingStart="7dp"
        android:padding="14dp"
        android:gravity="center_horizontal|top"
        android:layout_alignParentBottom="true">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:tint="@color/Black"
            app:srcCompat="@drawable/ic_info"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/Black"
            android:layout_marginEnd="10dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/VitalMsg"
            android:textSize="16sp"/>
    </LinearLayout>
</RelativeLayout>